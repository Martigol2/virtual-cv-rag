# Get a free key at https://build.nvidia.com (sign in, then "Get API Key" on any model page)
NVIDIA_API_KEY=

# Run `npm run list-models` after setting NVIDIA_API_KEY above to see what's
# available to your key, then fill these in. Example shapes seen on NVIDIA's
# catalog (verify yours still exists before using it):
#   NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
#   NVIDIA_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_CHAT_MODEL=
NVIDIA_EMBED_MODEL=
